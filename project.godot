; LAST LECTURE — native Godot 4 project. Open this file via Godot Project Manager.
config_version=5

[application]
config/name="LAST LECTURE — The Forgotten Programming Wing"
config/version="M29"
run/main_scene="res://scenes/stage_01/folding_library_m29.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
2d/default_gravity=2050.0

[debug]
gdscript/warnings/untyped_declaration=0
